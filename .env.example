# Local demo only: every value below is a throwaway for a stack bound to 127.0.0.1.
# Copy to .env to override; compose.yaml falls back to these same defaults when .env is absent.

# Host ports (all bound to 127.0.0.1; the 1xxxx range avoids clashes with other local stacks).
KAFKA_PORT=19092
SCHEMA_REGISTRY_PORT=18081
KAFKA_UI_PORT=18090
S3_API_PORT=19000
S3_CONSOLE_PORT=19001
ICEBERG_REST_PORT=18181
TRINO_PORT=18080
SPARK_UI_PORT=14040

# Endpoints for host-side tools and tests. Containers use kafka:29092,
# http://schema-registry:8081, http://s3:9000, http://iceberg-rest:8181 and trino:8080 (set in
# compose.yaml).
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19092
SCHEMA_REGISTRY_URL=http://127.0.0.1:18081
S3_ENDPOINT=http://127.0.0.1:19000
ICEBERG_REST_URI=http://127.0.0.1:18181
TRINO_HOST=127.0.0.1

# Trino client (lakestream check). TRINO_PORT above is both the host port and the client's port.
TRINO_USER=lakestream
TRINO_CATALOG=lake

# Object storage and Iceberg catalog. The REST catalog does not hand S3 settings to clients, so
# host-side tools take S3_ENDPOINT above.
S3_ACCESS_KEY=lake_admin
S3_SECRET_KEY=lake_secret_pw
S3_REGION=us-east-1
S3_BUCKET=lakehouse
ICEBERG_WAREHOUSE=s3://lakehouse/warehouse
ICEBERG_CATALOG=lake

# Topics (names are part of the contract in docs/PLAN.md).
KAFKA_TOPIC=shop.events
KAFKA_DLQ_TOPIC=shop.events.dlq

# KRaft cluster id: 22 characters of base64. Changing it needs a fresh kafka_data volume.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# Producer defaults, one per `lakestream produce` option. Uncomment to override.
# PRODUCER_SESSIONS=400
# PRODUCER_USERS=250
# PRODUCER_SEED=42
# PRODUCER_BASE_TIME=2026-01-01T00:00:00Z
# PRODUCER_SPAN_MINUTES=90
# PRODUCER_RATE=0
# PRODUCER_DUPLICATE_RATE=0.02
# PRODUCER_LATE_RATE=0.03
# PRODUCER_LATE_MAX_SECONDS=180
# PRODUCER_MALFORMED=10
# PRODUCER_INVALID=14

# Consumer defaults, one per setting. Uncomment to override.
# CONSUMER_GROUP_ID=bronze-ingest
# CONSUMER_BATCH_MAX_MESSAGES=2000
# CONSUMER_BATCH_MAX_SECONDS=5
# CONSUMER_WRITE_RETRIES=5
# CONSUMER_BRONZE_TABLE=bronze.events
# CONSUMER_HEARTBEAT_FILE=/tmp/consumer-heartbeat

# Spark jobs (spark-job container). The image sets SPARK_IVY_DIR=/opt/spark-ivy and
# SPARK_CHECKPOINT_ROOT=/checkpoints; host-side runs (WSL) default to no Ivy dir and /checkpoints.
# SPARK_MASTER=local[2]
# SPARK_DRIVER_MEMORY=1g
# SPARK_IVY_DIR=
# SPARK_CHECKPOINT_ROOT=/checkpoints
